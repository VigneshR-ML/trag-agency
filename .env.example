# Shared secret that guards every write to /api/admin/* and /studio.
# Set locally in .dev.vars (git-ignored) and as a Worker secret in production:
#   npx wrangler secret put ADMIN_PASSWORD
ADMIN_PASSWORD=

# Optional. Separate HMAC key for admin session cookies. When empty, the
# session key is derived from ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=
